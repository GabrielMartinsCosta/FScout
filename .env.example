# Copie para .env e ajuste. Todas as variaveis usam o prefixo FSCOUT_.

# Banco. SQLite por padrao; o schema e portavel para Postgres sem alteracao.
FSCOUT_DATABASE_URL=sqlite:///data/db/fscout.db

# Raiz do repositorio open-data da StatsBomb (mirror do GitHub via raw).
FSCOUT_STATSBOMB_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data

# Cache local dos JSON baixados, para nao rebaixar a cada ingestao.
FSCOUT_RAW_DIR=data/raw

FSCOUT_LOG_LEVEL=INFO
